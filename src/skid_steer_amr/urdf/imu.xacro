<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU inside the chassis. Publishes /imu/data (sensor_msgs/Imu). -->

  <!-- Noise standard deviations (0 = ideal sensor) -->
  <xacro:property name="imu_gyro_stddev"  value="0.0"/>
  <xacro:property name="imu_accel_stddev" value="0.0"/>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="gaussian" params="stddev">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
    </noise>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x><xacro:gaussian stddev="${imu_gyro_stddev}"/></x>
          <y><xacro:gaussian stddev="${imu_gyro_stddev}"/></y>
          <z><xacro:gaussian stddev="${imu_gyro_stddev}"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:gaussian stddev="${imu_accel_stddev}"/></x>
          <y><xacro:gaussian stddev="${imu_accel_stddev}"/></y>
          <z><xacro:gaussian stddev="${imu_accel_stddev}"/></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
