<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>skid_steer_amr</name>
  <version>0.1.0</version>
  <description>
    Four-wheel skid-steer autonomous mobile robot for ROS 2 Humble and Gazebo Classic:
    URDF/xacro model, LiDAR, IMU, camera, EKF odometry fusion, SLAM Toolbox mapping,
    AMCL localization and Nav2 navigation.
  </description>

  <maintainer email="jaykumbharkar@gmail.com">Jay Kumbharkar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot description and visualisation -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Simulation -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>

  <!-- Localization, mapping and navigation -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- lets Gazebo resolve package://skid_steer_amr/meshes/... -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>

</package>
